@using Enigma5.App.Common.Extensions
@using Enigma5.App.Models
@using Enigma5.App.Resources.Commands
@using Enigma5.App.Resources.Handlers
@using Enigma5.App.Resources.Queries
@using Enigma5.App.UI.Common
@using Enigma5.App.UI.Dashboard
@using Enigma5.Security.Contracts
@using System.Collections.Immutable
@using System.Text
@using MediatR
@using System.Collections.ObjectModel

@page "/Dashboard"
@rendermode InteractiveServer
@implements IDisposable

@inject IMediator Mediator
@inject DashboardUIState DashboardUIState

<div class="row justify-content-center h-100">
    <div class="d-flex flex-column justify-content-between col col-3 ">
        <PassphraseInput OnUnlockKey="UnlockPrivateKey" OnLockKey="LockPrivateKey" />
        <ExportContactDataQrCode />
    </div>
    <div class="col col-9">
        <PeersInput Items="Peers" OnAddItem="SubmitNewPeer" OnRemoveItem="RemovePeer" OnRetry="ReloadPeerConnections" />
    </div>
</div>
<ToastHost @ref="Toasts" />

@code {
    private bool _disposed;
    private ToastHost Toasts = default!;
    private IEnumerable<PeerDto> Peers = [];
    private IReadOnlyCollection<PeerDto> InboundPeers = new HashSet<PeerDto>();
    private IReadOnlyCollection<PeerDto> OutboundPeers = new HashSet<PeerDto>();

    protected override Task OnInitializedAsync()
    {
        DashboardUIState.InboundPeersChanged += OnInboundPeersChanged;
        DashboardUIState.OutboundPeersChanged += OnOutboundPeersChanged;
        InboundPeers = DashboardUIState.InboundPeers;
        OutboundPeers = DashboardUIState.OutboundPeers;
        return LoadPeers();
    }

    private Task OnInboundPeersChanged(IReadOnlyCollection<PeerDto> peers)
    => InvokeAsync(() =>
    {
        InboundPeers = peers;
        return LoadPeers();
    });

    private Task OnOutboundPeersChanged(IReadOnlyCollection<PeerDto> peers)
    => InvokeAsync(() =>
    {
        OutboundPeers = peers;
        return LoadPeers();
    });

    private Task LoadPeers()
    {
        var result = new HashSet<PeerDto>(OutboundPeers);
        foreach (var outboundPeer in OutboundPeers)
        {
            outboundPeer.Connected = InboundPeers.Contains(outboundPeer);
            result.Add(outboundPeer);
        }
        Peers = result.Union(InboundPeers);
        return InvokeAsync(StateHasChanged);
    }

    // Returns true when the peer was added. The checks are the ones AddPeerHandler makes, done here to name the reason.
    private async Task<bool> SubmitNewPeer(PeerDto peer)
    {
        if (string.IsNullOrWhiteSpace(peer.Host) || string.IsNullOrWhiteSpace(peer.Address))
        {
            Toasts.Show("Enter the host and the address of the peer.", error: true);
            return false;
        }
        if (!Uri.TryCreate(peer.Host, UriKind.Absolute, out _))
        {
            Toasts.Show("The host must be a full address, for example http://example.onion.", error: true);
            return false;
        }
        if (!peer.Address.IsValidAddress())
        {
            Toasts.Show("The peer address is not valid.", error: true);
            return false;
        }

        var result = await Mediator.Send(new AddPeerCommand(peer.Host, peer.Address));
        if (!result.IsSuccessNotNullResultValue())
        {
            Toasts.Show("The peer could not be added. Check that its address is not already in the list.", error: true);
            return false;
        }
        Toasts.Show("Peer added.");
        return true;
    }

    private async Task RemovePeer(PeerDto peer)
    {
        if (peer.Id == null)
        {
            return;
        }
        var result = await Mediator.Send(new RemovePeerCommand(peer.Id.Value));
        if (!result.IsSuccessResult())
        {
            Toasts.Show("The peer could not be removed.", error: true);
        }
    }

    private async Task UnlockPrivateKey(char[] passphrase)
    {
        var result = await Mediator.Send(new SetMasterPassphraseCommand(passphrase));
        Array.Clear(passphrase);
        if (result.Value != true)
        {
            Toasts.Show("The key could not be unlocked. Check the passphrase.", error: true);
        }
    }

    private async Task LockPrivateKey()
    {
        var result = await Mediator.Send(new RemoveMasterPassphraseCommand());
        if (result.Value != true)
        {
            Toasts.Show("The key could not be locked.", error: true);
        }
    }

    private Task ReloadPeerConnections() => Mediator.Send(new InvokeNetworkBridgeCommand());

    public void Dispose()
    {
        if (!_disposed)
        {
            DashboardUIState.InboundPeersChanged -= OnInboundPeersChanged;
            DashboardUIState.OutboundPeersChanged -= OnOutboundPeersChanged;
            _disposed = true;
        }
    }
}