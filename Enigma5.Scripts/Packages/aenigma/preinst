set -e

SERVICE_NAME="aenigma"
DEFAULTS_FILE="/usr/lib/$SERVICE_NAME/appsettings.json"
CONFIG_DIR="/etc/$SERVICE_NAME"
OLD_DEFAULTS_FILE="$CONFIG_DIR/appsettings.json.old-defaults"

case "$1" in
  install|upgrade)
    # Versions before 5.1.0 kept a full copy of the defaults in /etc/aenigma/appsettings.json.
    # The defaults of the installed version are saved here, before they are replaced;
    # postinst compares them with the operator's file to find the operator's own settings.
    if [ -n "${2:-}" ] && dpkg --compare-versions "$2" lt "5.1.0" \
       && [ -f "$DEFAULTS_FILE" ] && [ -d "$CONFIG_DIR" ]; then
      cp -f "$DEFAULTS_FILE" "$OLD_DEFAULTS_FILE"
    fi
    ;;
esac

#DEBHELPER#

exit 0
