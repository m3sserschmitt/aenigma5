@using Enigma5.App.Models

<div class="list-group-item list-group-item-action rounded shadow-sm">
    <div class="row">
        <div class="col col-4">
            <p class="m-0 text-break">@Model.Host</p>
            @if (Model.Id is null)
            {
                @* Not in this node's peer list: the other node connected to this one. *@
                <p class="text-muted small m-0">incoming</p>
            }
        </div>
        <div class="col col-5">
            <p class="m-0 text-break">@Model.Address</p>
        </div>
        <div class="col col-2">
            <p class="@(Model.Connected ? "text-success" : "text-danger") small text-nowrap m-0">
                @(Model.Connected ? "Connected" : "Disconnected")
            </p>
        </div>
        <div class="col col-1">
            @if (Model.Id > 0)
            {
                <button class="d-flex btn btn-outline-danger rounded-circle align-items-center justify-content-center" @onclick="Remove">
                    <i class="bi bi-trash"></i>
                </button>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public required PeerDto Model { get; set; }
    [Parameter] public EventCallback<PeerDto> OnRemove { get; set; } = default;

    private Task Remove() => OnRemove.InvokeAsync(Model);
}