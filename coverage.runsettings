<?xml version="1.0" encoding="utf-8"?>
<!-- Settings for code coverage. See the README for the command that uses this file. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- Test code is not measured: the test projects and the helpers they share. -->
          <Exclude>[*.Tests]*,[Enigma5.Tests.Base]*</Exclude>
          <IncludeTestAssembly>false</IncludeTestAssembly>
          <!-- Code that is generated, or marked as not to be measured. -->
          <ExcludeByAttribute>ExcludeFromCodeCoverageAttribute,GeneratedCodeAttribute</ExcludeByAttribute>
          <!-- Database migrations are generated by Entity Framework. -->
          <ExcludeByFile>**/Migrations/*.cs</ExcludeByFile>
          <SkipAutoProps>true</SkipAutoProps>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
