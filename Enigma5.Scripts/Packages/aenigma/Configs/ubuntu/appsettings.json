{
  "ConnectionStrings": {
    "DbConnectionString": "data source=/var/lib/aenigma/db/aenigmaDb.sqlite"
  },
  "DbProvider": "Sqlite",
  "Kestrel": {
    "EndPoints": {
      "Http": {
        "Url": "http://127.0.0.1:8080"
      },
      "HttpControl": {
        "Url": "http://127.0.0.1:8081"
      }
    }
  },
  "HttpBlacklists": [
    {
      "Endpoint": "http://127.0.0.1:8080",
      "Items": [
        {
          "Path": "/Dashboard",
          "Methods": [
            "GET"
          ]
        }
      ]
    }
  ],
  "HubBlacklists": [
    {
      "Endpoint": "http://127.0.0.1:8080",
      "Items": [
        {
          "Methods": [
            "TriggerBroadcast"
          ]
        }
      ]
    }
  ],
  "OnionService": null,
  "Socks5Proxy": "socks5://127.0.0.1:9050",
  "KeySource": "File",
  "PassphraseSource": "Dashboard",
  "AzureVaultUrl": null,
  "PrivateKeyPath": "/usr/local/etc/aenigma/private-key.pem",
  "PublicKeyPath": "/usr/local/etc/aenigma/public-key.pem",
  "PassphrasePath": null,
  "WebContentDirectory": "/srv/aenigma/uploads",
  "MessageRetentionPeriod": "14.00:00:00",
  "SentMessageRetentionPeriod": "00:00:00",
  "SharedDataRetentionPeriod": "14.00:00:00",
  "FilesRetentionPeriod": "03.00:00:00",
  "SharedDataMaxSize": 16384,
  "SharedFileMaxSize": 67108864,
  "Hostname": null,
  "VertexLifetime": "00:30:00",
  "Network": {
    "DelayBetweenConnectionRetries": 3000
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Error",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore.Hosting.Diagnostics": "Error",
        "Microsoft.Hosting.Lifetime": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/var/log/aenigma/aenigma-logs-.txt",
          "rollingInterval": "Day",
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  }
}