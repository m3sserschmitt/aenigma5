@implements IDisposable

<div class="toast-container position-fixed top-0 end-0 p-3">
    @foreach (var toast in Toasts)
    {
        <div class="toast show align-items-center text-white border-0 @(toast.Error ? "bg-danger" : "bg-success")" role="alert">
            <div class="d-flex">
                <div class="toast-body">@toast.Text</div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" aria-label="Close"
                    @onclick="() => Remove(toast)"></button>
            </div>
        </div>
    }
</div>

@code {
    private static readonly TimeSpan Lifetime = TimeSpan.FromSeconds(6);
    private readonly List<ToastMessage> Toasts = [];
    private bool _disposed;

    public void Show(string text, bool error = false)
    {
        var toast = new ToastMessage(text, error);
        Toasts.Add(toast);
        StateHasChanged();
        _ = RemoveLaterAsync(toast);
    }

    private async Task RemoveLaterAsync(ToastMessage toast)
    {
        await Task.Delay(Lifetime);
        if (!_disposed)
        {
            await InvokeAsync(() => Remove(toast));
        }
    }

    private void Remove(ToastMessage toast)
    {
        if (!_disposed && Toasts.Remove(toast))
        {
            StateHasChanged();
        }
    }

    public void Dispose() => _disposed = true;

    private sealed record ToastMessage(string Text, bool Error);
}
