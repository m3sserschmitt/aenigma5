set -Eeuo pipefail

SERVICE_NAME="aenigma"
SERVICE_USER="aenigma"
LOG_DIR="/var/log/$SERVICE_NAME"
SRV_DIR="/srv/$SERVICE_NAME"
UPLOADS_DIR="$SRV_DIR/uploads"
LIB_DIR="/var/lib/$SERVICE_NAME"
DATABASE_DIR="$LIB_DIR/db"
PRIVATE_KEY_FILE="$LIB_DIR/private-key.pem"

case "$1" in
  configure)
    if ! id "$SERVICE_USER" >/dev/null 2>&1; then
      echo "Creating user '$SERVICE_USER' for the service..."
      useradd --system --no-create-home --shell /usr/sbin/nologin "$SERVICE_USER"
    fi

    mkdir -pv "$LOG_DIR"
    chown "$SERVICE_USER":"$SERVICE_USER" "$LOG_DIR"
    chmod 755 "$LOG_DIR"

    mkdir -pv "$LIB_DIR"
    chown "$SERVICE_USER":"$SERVICE_USER" "$LIB_DIR"
    chmod 755 "$LIB_DIR"

    mkdir -pv "$DATABASE_DIR"
    chown "$SERVICE_USER":"$SERVICE_USER" "$DATABASE_DIR"
    chmod 755 "$DATABASE_DIR"

    mkdir -pv "$SRV_DIR"
    chown "$SERVICE_USER":"$SERVICE_USER" "$SRV_DIR"
    chmod 755 "$SRV_DIR"

    mkdir -pv "$UPLOADS_DIR"
    chown "$SERVICE_USER":"$SERVICE_USER" "$UPLOADS_DIR"
    chmod 755 "$UPLOADS_DIR"

    if [ ! -f "$PRIVATE_KEY_FILE" ]; then
      touch "$PRIVATE_KEY_FILE"
    fi

    chown "$SERVICE_USER":"$SERVICE_USER" "$PRIVATE_KEY_FILE"
    chmod 600 "$PRIVATE_KEY_FILE"
    ;;
  abort-upgrade|abort-remove|abort-deconfigure)
    ;;
  *)
    ;;
esac

#DEBHELPER#

exit 0
