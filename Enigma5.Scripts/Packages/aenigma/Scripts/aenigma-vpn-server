# the Free Software Foundation, either version 3 of the License, or
# (at your option) any later version.

# Aenigma is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.

# You should have received a copy of the GNU General Public License
# along with Aenigma.  If not, see <https://www.gnu.org/licenses/>.

set -Eeuo pipefail
 
SERVICE_USER="openvpn"
OPENVPN_DIRECTORY="/etc/openvpn"
EASYRSA_DIRECTORY="$OPENVPN_DIRECTORY/easy-rsa"
EASYRSA="$EASYRSA_DIRECTORY/easyrsa"
EASYRSA_PKI="$EASYRSA_DIRECTORY/pki"
export EASYRSA_PKI

show_help() {
    echo "Usage: $0 -d DOMAIN -p PORT -a ADDRESS -n NETMASK [-f INTERFACE]"
    echo ""
    echo "Options:"
    echo "  -d DOMAIN       The domain name for the server (e.g., example.com)"
    echo "  -p PORT         VPN port (e.g., 1194)"
    echo "  -a ADDRESS      VPN network address (e.g., 10.8.0.0)"
    echo "  -n NETMASK      VPN network netmask (e.g., 255.255.255.0)"
    echo "  [-f INTERFACE]  (Optional) Name of the tunnel interface, at most 15 characters"
    echo "                  (default: tun- and 11 characters of the SHA-256 hash of DOMAIN)"
    echo ""
    echo "Example:"
    echo "  sudo $0 -d example.com -p 1194 -a 10.8.0.0 -n 255.255.255.0"
    exit 1
}

[[ $EUID -ne 0 ]] && { echo "ERROR: Run as root: sudo bash $0"; exit 1; }

if [ "$#" -lt 8 ]; then
    show_help
fi

while getopts "d:p:a:n:f:h" opt; do
    case $opt in
        d) DOMAIN=$OPTARG ;;
        p) PORT=$OPTARG ;;
        a) ADDRESS=$OPTARG ;;
        n) NETMASK=$OPTARG ;;
        f) INTERFACE=$OPTARG ;;
        h) show_help ;;
        *) show_help ;;
    esac
done

if [[ ! -v DOMAIN || ! -v PORT || ! -v ADDRESS || ! -v NETMASK ]]; then
    echo "Error: DOMAIN, PORT, ADDRESS, NETMASK are required."
    show_help
fi

# The tunnel interface gets a fixed name, so that other tools (aenigma-vpn-dns) and the operator can refer
# to it. With "dev tun" the kernel would number the interfaces of all servers in the order they start.
if [[ ! -v INTERFACE ]]; then
    INTERFACE="tun-$(printf '%s' "$DOMAIN" | sha256sum | cut -c1-11)"
fi
if [[ ${#INTERFACE} -gt 15 || ! "$INTERFACE" =~ ^[A-Za-z0-9._-]+$ ]]; then
    echo "ERROR: '$INTERFACE' is not a valid interface name: at most 15 letters, digits, '.', '_' or '-'."
    exit 1
fi
for OTHER_CONF in "$OPENVPN_DIRECTORY"/*.conf; do
    [[ -f "$OTHER_CONF" && "$OTHER_CONF" != "$OPENVPN_DIRECTORY/$DOMAIN.conf" ]] || continue
    if grep -qx "dev $INTERFACE" "$OTHER_CONF"; then
        echo "ERROR: The interface name '$INTERFACE' is already used by $OTHER_CONF. Choose another one with -f."
        exit 1
    fi
done

LOG_DIRECTORY="/var/log/openvpn/$DOMAIN"
CLIENT_CONFIGS_DIRECTORY="$OPENVPN_DIRECTORY/ccd/$DOMAIN"
SERVER_DIRECTORY="$OPENVPN_DIRECTORY/$DOMAIN"

apt-get update -qq
apt-get install -y openvpn easy-rsa

# Create unprivileged openvpn user/group if they don't exist
if ! id "$SERVICE_USER" &>/dev/null; then
    echo "Creating user '$SERVICE_USER' for the service..."
    useradd --system --no-create-home --shell /usr/sbin/nologin "$SERVICE_USER"
fi

# Create required directories
mkdir -p "$SERVER_DIRECTORY"
mkdir -p "$CLIENT_CONFIGS_DIRECTORY"
mkdir -p "$LOG_DIRECTORY"

# First run: initialise PKI and build CA. Each step is checked on its own, so a run that stopped half-way
# (for example, CA passphrases that do not match, or Ctrl+C during gen-dh) is completed by the next run.
if [[ ! -f "${EASYRSA_PKI}/ca.crt" ]]; then
    # Without a CA certificate nothing can have been signed: what an unfinished first run left is removed.
    # A CA that was completed once (its certificate was copied to $OPENVPN_DIRECTORY) or that has issued
    # certificates is never removed.
    if [[ -d "$EASYRSA_DIRECTORY" ]]; then
        if [[ -f "$OPENVPN_DIRECTORY/ca.crt" ]] || compgen -G "${EASYRSA_PKI}/issued/*.crt" > /dev/null; then
            echo "ERROR: ${EASYRSA_PKI}/ca.crt is missing, but $EASYRSA_DIRECTORY belongs to a CA that was completed before."
            echo "Check it by hand; it is left unchanged."
            exit 1
        fi
        echo "An earlier first run did not finish; removing $EASYRSA_DIRECTORY and building the CA again."
        rm -rf "$EASYRSA_DIRECTORY"
    fi
    make-cadir "$EASYRSA_DIRECTORY"
    "$EASYRSA" --batch init-pki
    # CA private key is passphrase-protected: you will be prompted to set
    # and confirm it now, and prompted again to unlock it every time a new
    # domain's server certificate is signed in the future.
    "$EASYRSA" --batch build-ca
fi
if [[ ! -f "${EASYRSA_PKI}/dh.pem" ]]; then
    "$EASYRSA" --batch gen-dh
fi
# Copied only when missing, so that files an operator replaced are kept.
[[ -f "$OPENVPN_DIRECTORY/ca.crt" ]] || cp -v "${EASYRSA_PKI}/ca.crt" "$OPENVPN_DIRECTORY/"
[[ -f "$OPENVPN_DIRECTORY/dh.pem" ]] || cp -v "${EASYRSA_PKI}/dh.pem" "$OPENVPN_DIRECTORY/"

# Refuse to regenerate an already-issued server certificate: re-running
# gen-req for an existing DOMAIN would silently overwrite its private key
# with a new, unrelated one, and the following sign-req would then fail
# because a certificate for that CN already exists - leaving the PKI in
# an inconsistent state.
if [[ -f "${EASYRSA_PKI}/issued/${DOMAIN}.crt" ]]; then
    echo "ERROR: A certificate for '$DOMAIN' is already issued at ${EASYRSA_PKI}/issued/${DOMAIN}.crt"
    echo "Refusing to regenerate it, as this would invalidate the existing private key."
    echo "Revoke the existing certificate with easyrsa first if you need to reissue it."
    exit 1
fi

"$EASYRSA" --batch gen-req "$DOMAIN" nopass
# CA is passphrase-protected: you will be prompted for the CA passphrase
# to sign this new server certificate.
"$EASYRSA" --batch sign-req server "$DOMAIN"
cp -v "${EASYRSA_PKI}/issued/${DOMAIN}.crt"  "$SERVER_DIRECTORY/"
cp -v "${EASYRSA_PKI}/private/${DOMAIN}.key" "$SERVER_DIRECTORY/"
chmod 700 "$EASYRSA_PKI/private"
chmod 600 "$EASYRSA_PKI/private"/*.key
chown -v "$SERVICE_USER:$SERVICE_USER" "$SERVER_DIRECTORY/${DOMAIN}.key"
chmod -v 600 "$SERVER_DIRECTORY/${DOMAIN}.key"
openvpn --genkey secret "$SERVER_DIRECTORY/ta.key"
chown -v "$SERVICE_USER:$SERVICE_USER" "$SERVER_DIRECTORY/ta.key"
chmod -v 600 "$SERVER_DIRECTORY/ta.key"

cat > "$OPENVPN_DIRECTORY/$DOMAIN.conf" << CONF
port $PORT
proto udp
dev $INTERFACE
dev-type tun
tun-mtu 1378

ca   $OPENVPN_DIRECTORY/ca.crt
cert $SERVER_DIRECTORY/$DOMAIN.crt
key  $SERVER_DIRECTORY/$DOMAIN.key
dh   $OPENVPN_DIRECTORY/dh.pem

topology subnet

server $ADDRESS $NETMASK
ifconfig-pool-persist $SERVER_DIRECTORY/ipp.txt
status $LOG_DIRECTORY/openvpn-status.log
 
client-config-dir $CLIENT_CONFIGS_DIRECTORY
client-to-client

keepalive 10 120

tls-auth $SERVER_DIRECTORY/ta.key 0

user $SERVICE_USER
group $SERVICE_USER

persist-key
persist-tun

explicit-exit-notify 1
verb 3
CONF

systemctl enable "openvpn@${DOMAIN}"
systemctl restart  "openvpn@${DOMAIN}"

echo ""
echo "Server setup complete."
echo "  Config file:      $OPENVPN_DIRECTORY/$DOMAIN.conf"
echo "  Cert/key/ta.key:  $SERVER_DIRECTORY/"
echo "  CCD directory:    $CLIENT_CONFIGS_DIRECTORY/"
echo "  Logs/status:      $LOG_DIRECTORY/"
echo "  Service:          openvpn@${DOMAIN}"
echo "  Tunnel interface: $INTERFACE"
